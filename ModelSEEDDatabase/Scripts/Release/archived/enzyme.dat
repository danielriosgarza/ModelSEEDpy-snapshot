DR   Q9Z8S4, UBIX_CHLPN ;  O84222, UBIX_CHLTR ;  Q9RR91, UBIX_DEIRA ;
DR   P0AG04, UBIX_ECO57 ;  P0AG03, UBIX_ECOLI ;  Q9ZJE3, UBIX_HELPJ ;
DR   O26011, UBIX_HELPY ;  Q57566, UBIX_METJA ;  O26250, UBIX_METTH ;
