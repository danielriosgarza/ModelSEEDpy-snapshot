DR   Q91Z85, CP17A_PERLE;  P19100, CP17A_PIG  ;  O57525, CP17A_RANDY;
DR   P11715, CP17A_RAT  ;  Q29497, CP17A_SHEEP;  Q92113, CP17A_SQUAC;
