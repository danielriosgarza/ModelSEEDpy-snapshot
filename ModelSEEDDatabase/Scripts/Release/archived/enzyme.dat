DR   P29239, LUXB2_PHOLE;  P23147, LUXB2_PHOLU;  P19908, LUXB_ALIFS ;
DR   P18300, LUXB_KRYAS ;  Q7N574, LUXB_PHOLL ;  P12744, LUXB_PHOPO ;
DR   P07739, LUXB_VIBHA ;
